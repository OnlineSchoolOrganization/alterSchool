generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.Citext
  password    String     @db.VarChar(255)
  phoneNumber String     @unique @db.VarChar(20)
  firstName   String?    @db.VarChar(64)
  lastName    String?    @db.VarChar(64)
  username    String     @db.VarChar(64)
  role        UserRole[] @default([USER])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  profiles    Profile[]
}

model Profile {
  id                String             @id @default(uuid()) @db.Uuid
  email             String?            @db.VarChar(255)
  phoneNumber       String?            @db.VarChar(20)
  firstName         String?            @db.VarChar(64)
  lastName          String?            @db.VarChar(64)
  username          String             @db.VarChar(64)
  profilePhoto      String?            @db.VarChar(255)
  userId            String             @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deleted           Boolean            @default(false)
  availabilitySlots AvailabilitySlot[]
  user              User               @relation(fields: [userId], references: [id])
  student           Student?
  teacher           Teacher?
  badges            Badge[]            @relation("ProfileToBadge")
}

model Student {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])
  teachers  Teacher[] @relation("StudentToTeacher")
  groups    Group[]
}

model Teacher {
  id        String    @id @default(uuid()) @db.Uuid
  bio       String    @db.VarChar(1024)
  profileId String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])
  students  Student[] @relation("StudentToTeacher")
  groups    Group[]

  stats TeacherStat[]
  pricingPlans PricingPlan[]
}

model TeacherStat {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  label     String   @db.VarChar(64)
  value     String   @db.VarChar(64)

  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model PricingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid

  type      String   @db.VarChar(32)   // Grup, Duo, Solo
  label     String   @db.VarChar(128)
  amount    Decimal  @db.Decimal(10, 2)
  benefits  String[]

  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model Group {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(128)
  description String?
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  teacherId   String         @db.Uuid
  students    Student[]
  price       Decimal        @db.Decimal(10, 2)
  capacity    Int
  benefits    String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessions    GroupSession[]
  promo GroupPromo?

  @@index([teacherId])
}

model GroupPromo {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @unique @db.Uuid
  badgeText   String   @db.VarChar(64)
  description String   @db.VarChar(255)
  oldPrice    Decimal? @db.Decimal(10, 2)

  group       Group    @relation(fields: [groupId], references: [id])
}

model GroupSession {
  id          String    @id @default(uuid()) @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  groupId     String    @db.Uuid
  dayOfWeek   DayOfWeek
  startTime   Int // Minutes from midnight
  duration    Int       @default(60) // in minutes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([groupId, dayOfWeek, startTime])
  @@index([groupId])
}

model Badge {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(64)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  profiles    Profile[] @relation("ProfileToBadge")
}

model AvailabilitySlot {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime Int
  duration  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])

  @@unique([profileId, dayOfWeek, startTime])
}

enum UserRole {
  SUPER_USER
  STAFF
  TEACHER
  USER
  GUEST
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
