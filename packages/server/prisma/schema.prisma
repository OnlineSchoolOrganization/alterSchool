model Teacher {
  id        String    @id @default(uuid()) @db.Uuid
  bio       String    @db.VarChar(1024)
  profileId String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])
  students  Student[] @relation("StudentToTeacher")
  groups    Group[]
}

model Group {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(128)
  description String?
  teacher     Teacher        @relation(fields: [teacherId], references: [id])
  teacherId   String         @db.Uuid
  students    Student[]
  price       Decimal        @db.Decimal(10, 2)
  capacity    Int
  benefits    String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessions    GroupSession[]

  @@index([teacherId])
}

model GroupSession {
  id          String    @id @default(uuid()) @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  groupId     String    @db.Uuid
  dayOfWeek   DayOfWeek
  startTime   Int // Minutes from midnight
  duration    Int       @default(60) // in minutes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([groupId, dayOfWeek, startTime])
  @@index([groupId])
}

model Badge {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(64)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  profiles    Profile[] @relation("ProfileToBadge")
}

model AvailabilitySlot {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  dayOfWeek DayOfWeek
  startTime Int
  duration  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])

  @@unique([profileId, dayOfWeek, startTime])
}

enum UserRole {
  SUPER_USER
  STAFF
  TEACHER
  USER
  GUEST
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
